def rastrear_drones(nome_arquivo):
    with open(nome_arquivo,'r') as arquivo:
        posições={}
        linhas=arquivo.readlines()
        for linha in linhas[1:]:
            elemento=linha.strip().split(',')
            if elemento[0] not in posições:
                posições[elemento[0]]=(0,0)
            x,y=posições[elemento[0]]
            if elemento[1]=='Cima':
                y+=int(elemento[2])
            elif elemento[1]=='Baixo':
                y-=int(elemento[2])
            elif elemento[1]=='Direita':
                x+=int(elemento[2])
            elif elemento[1]=='Esquerda':
                x-=int(elemento[2])
            posições[elemento[0]] = (x, y)
        return posições

