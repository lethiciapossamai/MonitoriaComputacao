def simular_mercado(capital,prob_queda,valor_aposta,dias):
    for rodadas in range(dias):
        if rd.random()<prob_queda:
            capital-=valor_aposta
        else:
            capital+=valor_aposta
        if capital<=0:
            return True
    return False

def analise_risco(capital,prob_queda,valor_aposta,lista_dias):
    resultados={}
    simulacoes=1000
    for dias in lista_dias:
        contador_quebras=0
        for rodada in range(simulacoes):
            if simular_mercado(capital,prob_queda,valor_aposta,dias):
                contador_quebras+=1
        resultados[dias]=(contador_quebras/simulacoes)*100
    return resultados

