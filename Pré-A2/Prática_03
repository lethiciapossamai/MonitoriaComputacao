def troca_figurinhas(A,B,C,D):
    saida_1=[]
    saida_2=[]
    for elemento in A:
        if elemento in D and elemento not in saida_1:
            saida_1.append(elemento)
    for elemento in C:
        if elemento in B and elemento not in saida_2:
            saida_2.append(elemento)
    return saida_1,saida_2

