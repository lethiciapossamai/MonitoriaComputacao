def divisores(n):
    div=[]
    for número in range(1,n+1):
        if n%número==0:
            div.append(número)
    return div

def verifica_primos(n):
    div=divisores(n)
    if  len(div)==2:
        return 1 #É primo
    else:
        return 0 #Não é primo

def primos_até(n):
    primos=[]
    for números in range(2,n+1):
        if verifica_primos(números)==1:
            primos.append(números)
    return primos

def quantos_até(n):
    return len(primos_até(n))

def enésimo_primo(n):
    parâmetro=0
    while quantos_até(parâmetro)<n:
        parâmetro+=n
    primos=primos_até(parâmetro)
    return primos[n-1]

