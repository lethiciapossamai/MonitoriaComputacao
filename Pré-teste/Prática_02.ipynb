    "nota_um=float(input('Primeira nota:'))\n",
    "nota_dois=float(input('Segunda nota:'))\n",
    "nota_três=float(input('Terceira nota:'))\n",
    "média=(nota_um+nota_dois+nota_três)/3\n",
    "print(f'A sua média é: {média:.2f}')\n",
    "if média>=6:\n",
    "    print('Aprovado')\n",
    "else:\n",
    "    print('Reprovado')"
