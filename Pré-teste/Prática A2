def palíndromo(frase_0):
    from string import punctuation
    frase_1=''.join(elemento for elemento in frase_0 if elemento not in punctuation)
    frase_2=frase_1.replace(' ','')
    frase_3=frase_2.lower()
    if frase_3==frase_3[::-1]:
        return True
    else:
        return False