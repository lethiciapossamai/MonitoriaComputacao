# Dada uma string, retorne o maior número de caracteres iguais consecutivos

def iguais_consecutivos(palavra):
    letras_iguais=[]
    repeticoes=[]
    maiores=[]
    agora_e_o_ultimo=[]
    for letra in palavra:
        if palavra.count(letra)>=2:
            letras_iguais.append(letra)
    for letra in letras_iguais:
        repeticoes.append(palavra.count(letra))
        repeticoes.sort(reverse=True)
    for letra in palavra:
        if palavra.count(letra)==repeticoes[0]:
            maiores.append([letra, repeticoes[0]])
    for elemento in maiores:
        while agora_e_o_ultimo.count(elemento)<1:
            agora_e_o_ultimo.append(elemento)
    return agora_e_o_ultimo

print(iguais_consecutivos('aaggagagagagagagagagagagaggaga'))

