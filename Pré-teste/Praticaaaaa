def leontief(L):
    listinha=[]
    listona=[]
    for lista in L:
        listinha.append([lista[0], (lista[1]/lista[2])])
    for elemento in listinha:
        listona.append(elemento[1])
    for elemento in listinha:
        if sorted(listona)[0]==elemento[1]:
            return elemento
    

